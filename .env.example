# ── MongoDB (audit log storage) ──────────────────────────────────────────────
MONGO_DB_URL=mongodb://localhost:27017
MONGO_DB_NAME=AuditLogsPreprod
MONGO_COLLECTION_RAW=raw
MONGO_COLLECTION_ENRICHED=enriched
MONGO_COLLECTION_DLQ=dlq

# Validator project root — defaults to this repo (python/audit_validator is vendored here)
AUDIT_PROJECT_ROOT=.

# ── UI / API ───────────────────────────────────────────────────────────────────
API_PORT=3200
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=200
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Target environment (pp | qa | uat) ───────────────────────────────────────
# Switched from the Generate UI. Also selects Mongo DB:
#   pp  → AuditLogsPreprod + https://nextgen.monotype-pp.com
#   qa  → AuditLogsQA      + https://nextgen-qa.monotype-pp.com
#   uat → AuditLogsUAT     + https://nextgen.monotype-uat.com
AUDIT_TARGET=pp

# ── OAuth (overridden by AUDIT_TARGET profile) ───────────────────────────────
# PP: password grant → https://secure-pp.monotype.com/oauth/token
# QA M2M: client_credentials → https://secure.monotype-pp.com/v2/oauth/token
# QA user/Discovery: password grant via NextGen SPA client (auto-minted —
#   set OAUTH_USERNAME / OAUTH_PASSWORD once; no Excel paste required)
# OAUTH_TOKEN_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUDIENCE=
# OAUTH_GRANT_TYPE=password
# OAUTH_ORG=org_YofCWU9hMf218uJr
# PP (AUDIT_TARGET=pp): mem.auditpreprodtest@gmail.com
# QA (AUDIT_TARGET=qa): monotype.staging+testuser11new@gmail.com
# OAUTH_USERNAME=
# OAUTH_PASSWORD=
# OAUTH_GCID=a4175cbf-1419-4a30-aa21-12109bf942f6
# AUTH0_* aliases are also accepted (AUTH0_TOKEN_URL, AUTH0_ORGANIZATION, …)

# ── GraphQL (overridden by AUDIT_TARGET profile) ──────────────────────────────
NEXTGEN_UI_URL=https://nextgen.monotype-pp.com
GRAPHQL_ENDPOINT=https://nextgen.monotype-pp.com/graphql
NEXTGEN_GRAPHQL_ENDPOINT=https://nextgen.monotype-pp.com/graph
NEXTGEN_ORIGIN=https://nextgen.monotype-pp.com
NEXTGEN_REFERER=https://nextgen.monotype-pp.com/discover-fonts/all

# Bearer tokens — required for simulation
BEARER_TOKEN=
# NEXTGEN_BEARER_TOKEN=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqps://user:pass@rabbitmq-preprod.monotype-pp.com:5671/mt-connect-preprod
# Platform mains (reference only): mt.platform.raw_events.resolver.queue /
#   mt.platform.events.notification.queue
# Automation / Mongo taps (preprod mt-connect-preprod vhost):
RAW_EVENTS_QUEUE="mtraw-automation(DO NOT DELETE)"
ENRICHED_EVENTS_QUEUE="mtenrich-automation(DO NOT DELETE)"
RAW_QUEUE_PASSIVE=true
ENRICHED_QUEUE_PASSIVE=true

# ── Ingestion service (RabbitMQ → Mongo, ported from audit-sense) ─────────────
# Subscription queues with catch-all routing — every event is persisted to Mongo,
# which is what keeps complete raw+enrich pairs available to validate.
INGEST_RAW_QUEUE="mtraw-automation(DO NOT DELETE)"
INGEST_ENRICHED_QUEUE="mtenrich-automation(DO NOT DELETE)"
# Fan-out: drain pp + qa tap queues in parallel (separate vhost → separate Mongo DB each).
INGEST_TARGETS=pp,qa
# Hourly purge of large ready backlogs on tap queues (acked messages are already removed).
INGEST_AUTO_PURGE=true
INGEST_AUTO_PURGE_INTERVAL_SEC=3600
INGEST_AUTO_PURGE_MIN_READY=500
INGEST_DLQ_QUEUE=mt.platform.raw_events.resolver.dlq
INGEST_PREFETCH=100
INGEST_BATCH_FLUSH_INTERVAL_MS=5000
INGEST_CLEANUP_INTERVAL_MS=30000
INGEST_CLEANUP_MAX_DOCS_PER_OPERATION=20
# Backend hourly Mongo retention sweep (runs even when ingestion is off).
MONGO_RETENTION_MAX_DOCS_PER_OPERATION=20
MONGO_RETENTION_INTERVAL_SEC=3600
# Purge each subscription queue's backlog when ingestion starts.
INGEST_PURGE_ON_START=false
# Auto-start RabbitMQ → Mongo dump when the backend boots (Generate verify needs this).
INGEST_AUTO_START=true

# ── Simulation seeds ──────────────────────────────────────────────────────────
SEED_FAMILY_ID=794981
SEED_DEACTIVATE_FAMILY_ID=
SEED_STYLE_ID=
GRAPHQL_CONTEXT_CUSTOMER_ID=

# ── Source validation APIs ────────────────────────────────────────────────────
# Prefer NextGen BFF search proxy for browser/Excel user JWTs:
#   DISCOVERY_BASE_URL={NEXTGEN_UI_URL}/api/search
# Bare mtc-middleware-discovery rejects Excel auth_token (401). Leave unset to
# auto-resolve from NEXTGEN_UI_URL / AUDIT_TARGET. Force middleware only with
# DISCOVERY_USE_MIDDLEWARE=true + a Discovery M2M token.
# DISCOVERY_BASE_URL=https://nextgen-qa.monotype-pp.com/api/search
# Max Discovery/Typesense calls per validation run — keep high so full runs fetch
SOURCE_VALIDATION_MAX_DISCOVERY_CALLS=500
# QA MySQL schemas: user_management_nextgenqa / customer_management_nextgenqa / …
MYSQL_QA_SCHEMA_SUFFIX=_nextgenqa
UMS_BASE_URL=https://usermanagement-pp.monotype.com
CMS_BASE_URL=https://customermanagement-preprod.monotype.com

# Source truth for Compare: api (HTTP) | db (MySQL for UMS/CMS/AMS; Typesense stays HTTP)
# SOURCE_TRUTH=api
# MYSQL_HOST=mosaicmysqlrdspreprod.cn8kri9cz75n.us-east-1.rds.amazonaws.com
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=asteria@asteria   # PPConfig default (not plain "asteria")
# FB / Font Bridge alternate: user zeus / password zeus@mt.comppdb (app_config.FB_DB_*)
# MYSQL_SSL=true

# ── Pipeline timing ───────────────────────────────────────────────────────────
EVENT_WAIT_TIMEOUT_MS=30000
PYTHON_SETTLE_SEC=120
ENRICHED_CATCHUP_SEC=180
# Ingress API (plugin / FontBridge / desktop): wait after last POST before raw+enrich check
INGRESS_SETTLE_SEC=300
# Extra Mongo poll budget after ingress settle (verify timeout = settle + buffer)
INGRESS_VERIFY_BUFFER_SEC=30
# Fall back to Mongo when ingestion drains the tap queues before the runner sees them
INGRESS_VERIFY_VIA_MONGO=true
# Ingress device + host context — override for your Monotype Connect install (About page)
# Priority: INGRESS_* env → INGRESS_DEVICE_FILE → macOS prefs → ingress_device.defaults.json
INGRESS_MACHINE_ID=Z0DGQF85CNYAKYPVJCW51JTSM291MED8E60NC9YDXCVZWD605Y60
INGRESS_UNIQUE_ID=7DC9A6DE16142DF572607138
INGRESS_APP_VERSION=2.2.2
# Optional per-machine JSON (copy ingress-device.example.json → ingress-device.local.json)
# INGRESS_DEVICE_FILE=./ingress-device.local.json
# INGRESS_OS_VERSION=26.5.1
# INGRESS_CPU_ARCH=arm64
# After Generate: poll Mongo for owned xCorrelationId in raw + enriched
GENERATE_VERIFY_TIMEOUT_SEC=90
GENERATE_VERIFY_POLL_SEC=5

# Compare parallelism (cut wall-clock on ~180+ ops)
SOURCE_VALIDATION_COMPARE_WORKERS=8
SOURCE_VALIDATION_DISCOVERY_WORKERS=12

# ── CasePilot MCP (Generate in UI) ───────────────────────────────────────────
# Create key under CasePilot → Connections → CasePilot MCP API
CASEPILOT_API_KEY=
CASEPILOT_MCP_URL=https://casepilot.monotype-pp.com/mcp
# REST base for the jobs/status fallback (defaults to MCP host minus /mcp)
CASEPILOT_PUBLIC_URL=https://casepilot.monotype-pp.com
# Optional overrides (else NEXTGEN_UI_URL + OAUTH_USERNAME/OAUTH_PASSWORD)
# CASEPILOT_UI_BASE_URL=https://nextgen.monotype-pp.com
# CASEPILOT_UI_USERNAME=
# CASEPILOT_UI_PASSWORD=
CASEPILOT_UI_BROWSER=chrome
CASEPILOT_UI_HEADLESS=true
# Default parallel browsers for Generate-in-UI (omit on MCP call = full PP cap)
# 1 = serial · 2+ = N browsers at once (clamped by CasePilot MCP_MAX_PARALLEL_JOBS)
# CASEPILOT_MAX_PARALLEL=2
# Retries when Cloudflare LB returns Session not found (default 15)
# CASEPILOT_SESSION_RETRIES=15
# Health badge retries (default 3) and cache TTL seconds (default 45)
# CASEPILOT_HEALTH_RETRIES=3
# CASEPILOT_HEALTH_CACHE_SEC=45
# Return HTTP immediately; dispatch runs in background (default true)
# CASEPILOT_ASYNC_DISPATCH=true
# Skip TestRail preview MCP call on Send (default false — set true to validate)
# CASEPILOT_PREVIEW_TESTRAIL=false
# Connector wait polls before queue (default 2)
# CASEPILOT_CONNECTOR_WAIT_TRIES=2

# ── Electron (Monotype Connect app ingress via CasePilot) ─────────────────────
# Auto-selected for ingress:app_* / Desktop App selections. Or force globally:
# CASEPILOT_UI_APP_TYPE=electron
# CASEPILOT_ELECTRON_APP_PATH=/Applications/Monotype NextGen/Monotype NextGen.app
# CASEPILOT_ELECTRON_ATTACH_MODE=launch
# CASEPILOT_ELECTRON_DEBUG_PORT=9222
# CASEPILOT_ELECTRON_AUTO_LOGIN=true
# CASEPILOT_ELECTRON_FORCE_FRESH_LOGIN=false
# CASEPILOT_ELECTRON_QUIT_EXISTING_BEFORE_LAUNCH=true
# CASEPILOT_ELECTRON_USE_OPEN_ON_MACOS=true
# CASEPILOT_ELECTRON_HEADLESS=false

# ── Connect service log harvest (app/plugin ingress Generate-in-UI) ───────────
# macOS only — reads ~/Library/Logs/Monotype/Monotype Connect/ConnectService/service
# CONNECT_LOG_CAPTURE=true
# offset = byte marker (safe; default). truncate = archive + clear — can break Serilog on open files
# CONNECT_LOG_PREPARE=offset
# Max wait after CasePilot finishes before giving up (logs can lag up to ~5 min)
# CONNECT_LOG_SETTLE_SEC=300
# CONNECT_LOG_POLL_SEC=15
# Re-schedule harvest when status=harvesting but worker died (e.g. uvicorn --reload)
# CONNECT_LOG_HARVEST_STALE_SEC=45

# ── Dev startup speed (scripts/dev.sh sets these automatically) ───────────────
# Skip Atlas index ensure on each restart (indexes already exist in shared envs)
# INGEST_ENSURE_INDEXES_ON_START=false
# Skip immediate Mongo retention sweep on boot
# MONGO_RETENTION_SKIP_STARTUP_SWEEP=true
# Skip pip when requirements unchanged (auto | true | false)
# DEV_SKIP_PIP=auto
