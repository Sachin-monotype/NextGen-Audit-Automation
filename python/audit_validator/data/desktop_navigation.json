      "category": "login",
      "navigation": [
        "Desktop app > Workspace switcher > Switch workspace"
      ],
      "trigger_hint": "need account app",
      "automatable": true,
      "steps": [
        {
          "action": "click",
          "selector": "[data-testid='workspace-switcher']",
          "xpath": "//button[contains(@aria-label,'workspace') or contains(@class,'workspace')]",
          "description": "Open workspace switcher"
        },
        {
          "action": "click",
          "selector": "[data-testid='workspace-option']:not([aria-selected='true'])",
          "xpath": "(//li[contains(@role,'option') and not(@aria-selected='true')])[1]",
          "description": "Select alternate workspace"
        }
