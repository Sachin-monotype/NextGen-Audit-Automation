    {
      "case_id": "app_language_changed",
      "event_name": "app.language.changed",
      "operation": "appLanguageChanged",
      "category": "desktop_app_preference_page",
      "navigation": [
        "Preferences > General > Language"
      ],
      "trigger_hint": "change language",
      "automatable": true,
      "steps": [
        {
          "action": "open_preferences_section",
          "selector": "",
          "xpath": "",
          "description": "Preferences general",
          "value": "general"
        },
        {
          "action": "select_option",
          "selector": "[data-qa-id='preferences-language-dropdown']",
          "xpath": "",
          "description": "Language (non-English to emit event)",
          "value": "Deutsch|Fran\u00e7ais|Espa\u00f1ol|\u65e5\u672c\u8a9e"
        },
        {
          "action": "sleep",
          "selector": "",
          "xpath": "",
          "description": "Settle language change",
          "value": "1.5"
        },
        {
          "action": "select_option",
          "selector": "[data-qa-id='preferences-language-dropdown']",
          "xpath": "",
          "description": "Restore English for remaining automation",
          "value": "English|Englisch"
        }
      ]
    },
