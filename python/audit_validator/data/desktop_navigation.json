{
  "source": "Desktop UI Navigation \u2014 selectors captured from NextGen QA Preferences / Help & Support / Profile (2026-08-05)",
  "target_url": "https://mt-audit-log-resolver-service-preprod.monotype-pp.com/v1/audit-events",
