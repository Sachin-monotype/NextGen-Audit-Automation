  "events": [
    {
      "case_id": "app_settings_auto_performance_enabled",
      "event_name": "app.settings.auto_performance.enabled",
      "operation": "appSettingsAutoPerformanceEnabled",
      "category": "desktop_app_preference_page",
      "navigation": [
        "Preferences > General > Auto performance management > Enable"
      ],
      "trigger_hint": "enable auto performance",
      "automatable": true,
      "steps": [
        {
          "action": "open_preferences_section",
          "selector": "",
          "xpath": "",
          "description": "Preferences general",
          "value": "general"
        },
        {
          "action": "toggle_on",
          "selector": "[data-qa-id='preferences-general-auto-performance-toggle']",
          "xpath": "",
          "description": "Auto performance ON"
        }
      ]
    },
    {
      "case_id": "app_settings_auto_performance_disabled",
      "event_name": "app.settings.auto_performance.disabled",
      "operation": "appSettingsAutoPerformanceDisabled",
      "category": "desktop_app_preference_page",
      "navigation": [
        "Preferences > General > Auto performance management > Disable"
      ],
      "trigger_hint": "disable auto performance",
      "automatable": true,
      "steps": [
        {
          "action": "open_preferences_section",
          "selector": "",
          "xpath": "",
          "description": "Preferences general",
          "value": "general"
        },
        {
          "action": "toggle_off",
          "selector": "[data-qa-id='preferences-general-auto-performance-toggle']",
          "xpath": "",
          "description": "Auto performance OFF"
        }
      ]
    },
    {
      "case_id": "app_settings_performance_mode_changed",
      "event_name": "app.settings.performance_mode.changed",
      "operation": "appSettingsPerformanceModeChanged",
      "category": "desktop_app_preference_page",
      "navigation": [
        "Preferences > General > Performance mode"
      ],
      "trigger_hint": "change performance mode",
      "automatable": true,
      "steps": [
        {
          "action": "open_preferences_section",
          "selector": "",
          "xpath": "",
          "description": "Preferences general",
          "value": "general"
        },
        {
          "action": "toggle_on",
          "selector": "[data-qa-id='preferences-general-auto-performance-toggle']",
          "xpath": "",
          "description": "Auto performance ON (enables mode dropdown)"
        },
        {
          "action": "select_option",
          "selector": "[data-qa-id='preferences-general-performance-mode-dropdown'],[data-testid='preferences-general-performance-mode-dropdown']",
          "xpath": "",
          "description": "Performance mode",
          "value": "Max performance|Max capacity|Optimal|Balanced"
        }
