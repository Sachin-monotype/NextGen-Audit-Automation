          "action": "goto",
          "selector": "",
          "xpath": "",
          "description": "Discover fonts",
          "value": "/discover-fonts/all"
        },
        {
          "action": "click",
          "selector": "button[aria-label='Open options menu']",
          "xpath": "",
          "description": "Open options menu"
        },
        {
          "action": "click_text",
          "selector": "",
          "xpath": "",
          "description": "Activate temporarily",
          "value": "Temporarily activate family|Activate temporarily|Temporary activate|Temp activate|Activate for temporary"
        }
      ]
    },
