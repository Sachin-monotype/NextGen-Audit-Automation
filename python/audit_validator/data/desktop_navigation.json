    {
      "case_id": "font_activation_type_switched",
      "event_name": "font.activation.type.switched",
      "operation": "fontActivationTypeSwitched",
      "category": "font_activations",
      "navigation": [
        "Discover Fonts / Search / My Library > Font card > Switch temp activation to permanent"
      ],
      "trigger_hint": "activate family",
      "automatable": true,
      "steps": [
        {
          "action": "click",
          "selector": "[data-testid='menu-item-Discover fonts']",
          "xpath": "",
          "description": "Discover fonts"
        }
      ]
    },
    {
      "case_id": "font_temp_activated",
      "event_name": "font.temp_activated",
      "operation": "fontTempActivated",
      "category": "font_activations",
      "navigation": [
        "Desktop app > Discover Fonts > Activate family (temporary)"
      ],
      "trigger_hint": "",
      "automatable": true,
      "steps": [
        {
          "action": "click",
          "selector": "[data-testid='nav-discover-fonts']",
          "xpath": "//a[contains(.,'Discover')]",
          "description": "Discover Fonts"
        },
        {
          "action": "click",
          "selector": "[data-testid='activate-family-btn']:first-of-type",
          "xpath": "(//button[contains(@aria-label,'Activate')])[1]",
          "description": "Temp activate first family"
        }
      ]
    },
    {
      "case_id": "font_localfont_activated",
      "event_name": "font.localfont.activated",
      "operation": "fontLocalfontActivated",
      "category": "font_activations",
      "navigation": [
        "Desktop app > My Inventory > System fonts > Activate font (row toggle)"
      ],
      "trigger_hint": "plugin",
      "automatable": true,
      "steps": [
        {
          "action": "click",
          "selector": "[data-testid='nav-my-inventory']",
          "xpath": "//a[contains(.,'My Inventory') or contains(.,'Inventory')]",
          "description": "My Inventory"
        },
        {
          "action": "click",
          "selector": "[data-testid='system-fonts-tab']",
          "xpath": "//button[contains(.,'System fonts')]",
          "description": "System fonts tab"
        },
        {
          "action": "click",
          "selector": "[data-testid='local-font-activate-toggle']:first-of-type",
          "xpath": "(//input[@type='checkbox' and contains(@aria-label,'Activate')])[1]",
          "description": "Activate local font"
        }
      ]
    },
    {
      "case_id": "font_localfont_deactivated",
